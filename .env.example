# ==============================================================================
# SAI Books – Tours & Travels Notes & Accounts
# Production Environment Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT: Never commit actual secrets or production credentials to Git!
# On Vercel, enter these values in Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Managed PostgreSQL - Neon / Supabase in Mumbai)
# ------------------------------------------------------------------------------
# Pooled connection string used by serverless runtime (e.g. PgBouncer / Neon pooler)
DATABASE_URL="postgresql://user:password@ep-mumbai-pooler.ap-south-1.aws.neon.tech/saibooks?sslmode=require&pgbouncer=true"

# Direct unpooled connection string used exclusively by Prisma during migrations
DIRECT_URL="postgresql://user:password@ep-mumbai.ap-south-1.aws.neon.tech/saibooks?sslmode=require"

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHY & SECURITY SECRETS
# ------------------------------------------------------------------------------
# Session authentication JWT secret (Generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-a-random-64-character-jwt-secret-string"

# AES-256 Field Level Data Encryption Key for Passports, Aadhaar, and PII
# Must be exactly 64 hexadecimal characters (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Secret token used by Vercel Cron to trigger scheduled jobs safely
# Generate with: openssl rand -hex 24
CRON_SECRET="replace-with-a-random-32-character-cron-secret-token"

# ------------------------------------------------------------------------------
# 3. AI & OCR INTELLIGENCE (Google Gemini API)
# ------------------------------------------------------------------------------
# API Key for natural language sentence parsing, OCR, and financial summaries
GEMINI_API_KEY="your-google-gemini-api-key-here"

# ------------------------------------------------------------------------------
# 4. PRIVATE CLOUD STORAGE (Vercel Blob / S3 / Cloudflare R2)
# ------------------------------------------------------------------------------
# Read/Write token for encrypted passport scans, invoices, and automated backups
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Resend / Postmark / SendGrid)
# ------------------------------------------------------------------------------
# Used for month-end reports, payment reminders, and password reset notifications
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM_ADDRESS="notifications@saitoursandtravels.in"

# ------------------------------------------------------------------------------
# 6. APPLICATION METADATA & DOMAIN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://books.saitoursandtravels.in"
NEXT_PUBLIC_APP_NAME="SAI Books"
NEXT_PUBLIC_BUSINESS_NAME="Sai Tours and Travels"
NEXT_PUBLIC_DEFAULT_LOCALE="ta-IN"

# ------------------------------------------------------------------------------
# 7. SECURE OWNER BOOTSTRAP (Created via: npm run bootstrap:owner)
# ------------------------------------------------------------------------------
OWNER_INITIAL_EMAIL="saipassportmdu@gmail.com"
# Optional: Leave empty to auto-generate a cryptographically secure random token
OWNER_INITIAL_PASSWORD=""

# ------------------------------------------------------------------------------
# 8. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="production"
